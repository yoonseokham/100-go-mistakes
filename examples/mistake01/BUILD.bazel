load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# 라이브러리 예제
go_library(
    name = "mistake01",
    srcs = ["lib.go"],
    importpath = "github.com/yourusername/go-100-mistakes/examples/mistake01",
    visibility = ["//visibility:public"],
)

# 바이너리 예제
go_binary(
    name = "example",
    srcs = ["main.go"],
    deps = [":mistake01"],
)

# 테스트 예제
go_test(
    name = "mistake01_test",
    srcs = ["lib_test.go"],
    embed = [":mistake01"],
)
